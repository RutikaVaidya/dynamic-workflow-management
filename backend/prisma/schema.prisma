generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  statusHistoryChanges OrderStatusHistory[] @relation("OrderHistoryChangedBy")

  @@map("users")
}

model Workflow {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  versions WorkflowVersion[]

  @@map("workflows")
}

model WorkflowVersion {
  id            Int       @id @default(autoincrement())
  workflowId    Int       @map("workflow_id")
  versionNumber Int       @map("version_number")
  status        String
  versionNote   String?   @map("version_note")
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workflow    Workflow             @relation(fields: [workflowId], references: [id])
  statuses    WorkflowStatus[]
  transitions WorkflowTransition[]
  orders      Order[]

  @@unique([workflowId, versionNumber])
  @@index([workflowId])

  @@map("workflow_versions")
}

model WorkflowStatus {
  id                Int      @id @default(autoincrement())
  workflowVersionId Int      @map("workflow_version_id")
  name              String
  code              String
  description       String?
  displayOrder      Int      @map("display_order")
  color             String?
  isInitial         Boolean  @default(false) @map("is_initial")
  isFinal           Boolean  @default(false) @map("is_final")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  workflowVersion     WorkflowVersion    @relation(fields: [workflowVersionId], references: [id])
  outgoingTransitions WorkflowTransition[] @relation("FromStatus")
  incomingTransitions WorkflowTransition[] @relation("ToStatus")
  ordersAsCurrent     Order[]            @relation("OrderCurrentStatus")
  historyFrom         OrderStatusHistory[] @relation("OrderHistoryFromStatus")
  historyTo           OrderStatusHistory[] @relation("OrderHistoryToStatus")

  @@unique([workflowVersionId, code])
  @@index([workflowVersionId])

  @@map("workflow_statuses")
}

model WorkflowTransition {
  id                Int      @id @default(autoincrement())
  workflowVersionId Int      @map("workflow_version_id")
  fromStatusId      Int      @map("from_status_id")
  toStatusId        Int      @map("to_status_id")
  actionName        String   @map("action_name")
  actionLabel       String   @map("action_label")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id])
  fromStatus      WorkflowStatus  @relation("FromStatus", fields: [fromStatusId], references: [id])
  toStatus        WorkflowStatus  @relation("ToStatus", fields: [toStatusId], references: [id])

  @@unique([workflowVersionId, fromStatusId, toStatusId])
  @@index([workflowVersionId])
  @@index([fromStatusId])
  @@index([toStatusId])

  @@map("workflow_transitions")
}

model Order {
  id                Int      @id @default(autoincrement())
  orderNumber       String   @unique @map("order_number")
  workflowVersionId Int      @map("workflow_version_id")
  currentStatusId   Int      @map("current_status_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  workflowVersion WorkflowVersion   @relation(fields: [workflowVersionId], references: [id])
  currentStatus   WorkflowStatus    @relation("OrderCurrentStatus", fields: [currentStatusId], references: [id])
  history         OrderStatusHistory[]

  @@index([workflowVersionId])
  @@index([currentStatusId])

  @@map("orders")
}

model OrderStatusHistory {
  id           Int      @id @default(autoincrement())
  orderId      Int      @map("order_id")
  fromStatusId Int?     @map("from_status_id")
  toStatusId   Int      @map("to_status_id")
  changedBy    Int?     @map("changed_by")
  comment      String?
  createdAt    DateTime @default(now()) @map("created_at")

  order        Order           @relation(fields: [orderId], references: [id])
  fromStatus   WorkflowStatus? @relation("OrderHistoryFromStatus", fields: [fromStatusId], references: [id])
  toStatus     WorkflowStatus  @relation("OrderHistoryToStatus", fields: [toStatusId], references: [id])
  changedByUser User?          @relation("OrderHistoryChangedBy", fields: [changedBy], references: [id])

  @@index([orderId])
  @@index([fromStatusId])
  @@index([toStatusId])

  @@map("order_status_history")
}